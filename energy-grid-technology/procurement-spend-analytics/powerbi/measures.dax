// Measures for the spend cube semantic model (tables from data/model/*.csv, see powerbi/README.md)

Spend = CALCULATE ( SUM ( fact_po_line[spend_eur] ), fact_po_line[is_return] = FALSE () )

Returns = - CALCULATE ( SUM ( fact_po_line[spend_eur] ), fact_po_line[is_return] = TRUE () )

Spend on Contract = CALCULATE ( [Spend], fact_po_line[contract_status] = "active" )

Contract Coverage % = DIVIDE ( [Spend on Contract], [Spend] )

Maverick Spend = CALCULATE ( [Spend], fact_po_line[maverick] = TRUE () )

Maverick (Expired Contract) = CALCULATE ( [Maverick Spend], fact_po_line[contract_status] = "expired" )

Active Suppliers = CALCULATE ( DISTINCTCOUNT ( fact_po_line[supplier_id] ), fact_po_line[is_return] = FALSE () )

Spend Share % = DIVIDE ( [Spend], CALCULATE ( [Spend], ALLSELECTED ( dim_supplier ) ) )

On-Time Delivery % =
    AVERAGEX (
        FILTER ( fact_po_line, NOT ISBLANK ( fact_po_line[on_time] ) ),
        fact_po_line[on_time]
    )

Defect Rate % = DIVIDE ( CALCULATE ( COUNTROWS ( fact_po_line ), fact_po_line[defect] = TRUE () ), COUNTROWS ( fact_po_line ) )

Spend PY = CALCULATE ( [Spend], DATEADD ( dim_month[month], -12, MONTH ) )

Spend YoY % = DIVIDE ( [Spend] - [Spend PY], [Spend PY] )

Spend 3M Avg = AVERAGEX ( DATESINPERIOD ( dim_month[month], MAX ( dim_month[month] ), -3, MONTH ), [Spend] )

// Pareto: cumulative share of the supplier in the current filter context, largest first
Cumulative Supplier Share % =
VAR CurrentSpend = [Spend]
VAR Cum =
    SUMX (
        FILTER ( ALLSELECTED ( dim_supplier[supplier_id] ), [Spend] >= CurrentSpend ),
        [Spend]
    )
RETURN DIVIDE ( Cum, CALCULATE ( [Spend], ALLSELECTED ( dim_supplier ) ) )

// Herfindahl-Hirschman index of supplier concentration (0-10,000) for the selected categories
Supplier HHI =
VAR Total = [Spend]
RETURN SUMX ( VALUES ( dim_supplier[supplier_id] ), POWER ( 100 * DIVIDE ( [Spend], Total ), 2 ) )
